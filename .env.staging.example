# ------------------------------------------------------------------------------
# Backend Environment Variables (backend/.env.staging)
# ------------------------------------------------------------------------------
ENVIRONMENT=staging
PORT=8000

SUPABASE_URL=https://biejxkrhypkkcvpbzjhh.supabase.co
SUPABASE_KEY=your-staging-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
