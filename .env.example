# ==============================================================================
# WorkForce SaaS — Monorepo Environment Configuration Template
# ==============================================================================
# Copy and configure in respective directories:
# - Frontend: copy to `frontend/.env.local`
# - Backend:  copy to `backend/.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (frontend/.env.local)
# ------------------------------------------------------------------------------
# Supabase project URL (hosted project or local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public publishable/anon API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API server URL
NEXT_PUBLIC_API_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# Backend Environment Variables (backend/.env)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# Supabase backend connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-admin-operations
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# Google Gemini API Key (Encapsulated on backend, never exposed to client)
GEMINI_API_KEY=your-gemini-api-key

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
